# Copy to tdengine-credentials.yaml, fill in real values and apply with the
# production overlay. The same user/password must be supplied to the
# market-data service through MarketDataService.spec.history (Secret ref), and
# the REST endpoint must sit behind TLS — never expose root/taosdata publicly.
apiVersion: v1
kind: Secret
metadata:
  name: tdengine-credentials
  namespace: match-eu-1
type: Opaque
stringData:
  user: REPLACE_WITH_TDENGINE_USER
  password: REPLACE_WITH_TDENGINE_PASSWORD
